{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rankzap",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  // The built app. /api/* goes to the Worker first; any other unknown path
  // gets index.html so the React router can handle it. /parties/* is where
  // the old PartyKit client connected: the Worker turns those sockets away
  // (passing a WebSocket to the assets handler crashes the local dev server).
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/parties/*"],
    "binding": "ASSETS"
  },
  "durable_objects": {
    "bindings": [{ "name": "POLLS", "class_name": "PollRoom" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["PollRoom"] }],
  "observability": { "enabled": true },
  // rankzap.site is a zone in the same Cloudflare account.
  "routes": [
    { "pattern": "rankzap.site", "custom_domain": true },
    { "pattern": "www.rankzap.site", "custom_domain": true }
  ]
}
